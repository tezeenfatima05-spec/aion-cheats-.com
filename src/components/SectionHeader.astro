---
interface Props {
  eyebrow: string;
  title: string;
  desc?: string;
  titleId?: string;
  centered?: boolean;
  wide?: boolean;
  /** Default h2 so each page keeps a single h1 (usually in the hero or page header). */
  heading?: 'h1' | 'h2';
}

const { eyebrow, title, desc, titleId, centered = false, wide = false, heading = 'h2' } = Astro.props;
const HeadingTag = heading;
---

<header
  class:list={[
    'section-header space-y-0',
    wide && 'section-header--wide',
    centered && 'mx-auto text-center',
  ]}
>
  <p class="section-header__eyebrow">{eyebrow}</p>
  <HeadingTag id={titleId} class="section-header__title">{title}</HeadingTag>
  {desc ? <p class="section-header__subtitle">{desc}</p> : null}
</header>
